# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitar .env ou .env.local com segredos
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle — snapshots gerados automaticamente não precisam de versionamento manual
# (mantenha as migrations, ignore só arquivos temporários)
*.sql.snap

# pnpm lock temporário
pnpm-lock.yaml.*

# IDEs
.idea/
.vscode/settings.json

# OS
Thumbs.db
