# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA commitar .env ou .env.local com segredos
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle — snapshots gerados automaticamente não precisam de versionamento manual
*.sql.snap

# pnpm lock temporários
pnpm-lock.yaml.*

# IDEs
.idea/
.vscode/settings.json
.cursor/

# OS
Thumbs.db

# ── Pastas internas / não pertencem ao repositório ──────────────

# Materiais de design e referência visual (apenas uso local)
/frontend-design-main/

# Prompts, documentos de IA e arquivos de planejamento (internos)
/prompts/

# Configurações de agentes de IA (Antigravity, Cursor, etc)
/.agents/

# ── Dados sensíveis — LGPD ───────────────────────────────────────

# CSVs com dados de pacientes — NUNCA no git
*.csv
*.xlsx
*.xls

# Arquivos de export/importação de dados
/exports/
/imports/
/backups/
