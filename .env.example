# ═══════════════════════════════════════════════════════════════
# Be4Hope — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com credenciais.
# ═══════════════════════════════════════════════════════════════

# ── Banco de Dados (Neon PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Aplicação ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Autenticação (Clerk) ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── E-mail (Brevo / Sendinblue) ──────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=noreply@seudominio.com

# ── Google Calendar + Meet (OAuth2) ───────────────────────────
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Upload de Documentos (Vercel Blob) ────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ── Chat em Tempo Real (Pusher) ───────────────────────────────
PUSHER_APP_ID=123456
PUSHER_KEY=abc123
PUSHER_SECRET=xyz789
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=abc123
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ── Jobs Agendados (Inngest) ─────────────────────────────────
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# ── Cron Jobs (Vercel) ────────────────────────────────────────
CRON_SECRET=secret-para-autenticar-cron-jobs

# ── Retransmissão de mídia da teleconsulta (Cloudflare Realtime TURN) ──
# Quando a videochamada não consegue conexão direta, a mídia passa por um servidor de
# retransmissão. SEM estas duas variáveis a chamada usa só STUN, e conexões que exigem
# relay falham — de propósito: é melhor falhar do que atravessar relay de terceiro sem
# contrato de operador, que era o comportamento até 20/08/2026.
# Como obter: painel da Cloudflare → Realtime → TURN. O token é de servidor, nunca do
# cliente — a credencial que o navegador usa é gerada em /api/teleconsulta/ice-servers,
# com validade de 2 horas.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── ChatPro — cadastro do paciente que chega pelo WhatsApp ─────────────────────
# Segredo do cabeçalho das rotas /api/chatpro/bot-link e /intake.
# Gere com: openssl rand -hex 32
CHATPRO_INTAKE_SECRET=

# Segredo que vai NO CAMINHO da URL do webhook. Gere separado do de cima.
# A URL a cadastrar no painel fica: https://SEU_DOMINIO/api/chatpro/webhook/<este-valor>
CHATPRO_WEBHOOK_PATH_TOKEN=

# 🔴 Credenciais da CHAT API. O token dá acesso a TODAS as conversas de pacientes.
# Painel do ChatPro → a instância → API.
CHATPRO_INSTANCE_ID=
CHATPRO_INSTANCE_TOKEN=
CHATPRO_CHAT_API_URL=https://sparks.chatpro.com.br

# Validade do link em horas (168 = 7 dias).
CHATPRO_LINK_TTL_HORAS=168

# Caminho do formulário de cadastro. O link fica: {APP_URL}{ESTE_CAMINHO}/{token}
CHATPRO_CADASTRO_PATH=/cadastro

# Confirmar o contato na API também no /intake. No /bot-link a confirmação é sempre feita.
CHATPRO_CONFIRMAR_NO_INTAKE=false

# Permite /start sem confirmar o contato, e SOMENTE com o identificador na URL.
CHATPRO_START_SEM_CONFIRMACAO=false

# ── Parceiros — handoff Greens ↔ BeHemp (ADR-0016) ──────────────────────────
# Um segredo POR DIREÇÃO. Vazar um não compromete o outro, e rotacionar um não
# exige parar as duas pontas ao mesmo tempo. Gerar com: openssl rand -hex 32
PARCEIRO_GREENS_SEGREDO_ENTRADA=
PARCEIRO_GREENS_SEGREDO_SAIDA=
PARCEIRO_GREENS_API_URL=https://api.greens-corp.com
# 🔴 AS DUAS ORIGENS, e o motivo não é excesso de zelo: greens-corp.com e
# www.greens-corp.com respondem 200 as DUAS, sem redirecionar — são origens distintas
# servindo o mesmo site (medido pelo lado da Greens em 09/09/2026).
# O `urlDeRetorno` deles é montado a partir de um GitHub Secret que ninguém lê. Se ele
# guardar `www` e a lista tiver só a raiz, a validação recusa — e a recusa é SILENCIOSA
# por desenho: o paciente fica sem o botão de volta e o cadastro funciona, então ninguém
# percebe. Duas origens custam nada e eliminam o caso.
PARCEIRO_ORIGENS_DE_RETORNO=https://greens-corp.com,https://www.greens-corp.com
