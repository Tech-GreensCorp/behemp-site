# ═══════════════════════════════════════════════════════════════
# Be4Hope — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com credenciais.
# ═══════════════════════════════════════════════════════════════

# ── Banco de Dados (Neon PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# ── Aplicação ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Autenticação (Clerk) ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── E-mail (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Google Calendar + Meet (OAuth2) ───────────────────────────
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Upload de Documentos (Vercel Blob) ────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ── Chat em Tempo Real (Pusher) ───────────────────────────────
PUSHER_APP_ID=123456
PUSHER_KEY=abc123
PUSHER_SECRET=xyz789
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=abc123
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ── Jobs Agendados (Inngest) ─────────────────────────────────
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# ── Cron Jobs (Vercel) ────────────────────────────────────────
CRON_SECRET=secret-para-autenticar-cron-jobs
